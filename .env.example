# ---------------------------------------------------------------------------
# Businessister — variables d'environnement
# Copier ce fichier en .env.local pour le développement local, et renseigner
# les mêmes variables dans Vercel (Project → Settings → Environment Variables).
# Les variables NEXT_PUBLIC_* sont publiques et intégrées au moment du build.
# ---------------------------------------------------------------------------

# URL publique du site (métadonnées, sitemap, données structurées).
NEXT_PUBLIC_SITE_URL=https://businessister.com

# Coordonnées affichées sur le site et dans les pages légales (facultatif).
# Rien n'est affiché si elles sont vides : aucune coordonnée n'est inventée.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Lien vers la réalisation SuperCalendar (URL à valider).
NEXT_PUBLIC_SUPERCALENDAR_URL=https://supercalendar.fr

# ---------------------------------------------------------------------------
# Réception des demandes d'audit — au moins un canal est requis.
# Sans canal configuré, le formulaire affiche une erreur explicite et
# n'indique JAMAIS un envoi réussi.
# ---------------------------------------------------------------------------

# Canal 1 : e-mail via Resend (https://resend.com). Secrets serveur uniquement.
RESEND_API_KEY=
# Destinataire(s), séparés par des virgules.
AUDIT_EMAIL_TO=
# Expéditeur vérifié dans Resend, ex. "Businessister <audit@businessister.com>".
AUDIT_EMAIL_FROM=

# Canal 2 : webhook HTTP (Make, Zapier, n8n, CRM…). Reçoit un JSON en POST.
AUDIT_WEBHOOK_URL=
# Facultatif : secret de signature HMAC SHA-256 (en-tête X-Businessister-Signature).
AUDIT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mesure d'audience (facultatif). Si renseigné, un bandeau de consentement
# s'affiche et Google Analytics n'est chargé qu'après acceptation.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
